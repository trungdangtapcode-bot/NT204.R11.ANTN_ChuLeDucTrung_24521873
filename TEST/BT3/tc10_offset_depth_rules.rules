# Test Case 10: content with offset and depth modifiers
# Rule 1: offset 0, depth 4 -> chi tim "USER" o ngay dau goi tin (index 0..4)
alert tcp any any -> any 21 (msg:"FTP USER at start"; content:"USER"; offset:0; depth:4; sid:1000001; rev:1;)

# Rule 2: offset 10, depth 10 -> chi tim "admin" trong khoang index 10 den 20
alert tcp any any -> any 21 (msg:"FTP admin in window"; content:"admin"; offset:10; depth:10; sid:1000002; rev:1;)
